<%= form_with(model: @restaurant, local: true) do |f| %>
  <% if @restaurant.errors.any? %>
    <div>
      <h3><%= pluralize(@restaurant.errors.count, "erro") %> impediram o salvamento:</h3>
      <ul>
        <% @restaurant.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Nome do restaurante" %><br>
    <%= f.text_field :name %>
  </div>

  <br>

  <div>
    <%= f.submit %>
  </div>
<% end %>
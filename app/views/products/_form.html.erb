<%= form_with model: [@restaurant, @product] do |f| %>
  <% if @product.errors.any? %>
    <div>
      <h2><%= pluralize(@product.errors.count, "erro") %> impediram o salvamento:</h2>
      <ul>
        <% @product.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Nome" %><br>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :price, "Preço" %><br>
    <%= f.number_field :price, step: 0.01 %>
  </div>

  <br>
  <%= f.submit %>
<% end %>

<div class="space-y-10">

  <div class="
    flex
    flex-col
    md:flex-row
    md:items-center
    md:justify-between
    gap-4
  ">

    <div>

      <h1 class="
        text-4xl
        font-bold
        text-gray-900
      ">
        Meus Pedidos
      </h1>

      <p class="
        text-gray-500
        mt-2
      ">
        Acompanhe o status dos seus pedidos.
      </p>

    </div>

    <%= link_to "← Voltar para Home",
        root_path,
        class: "
          text-gray-500
          hover:text-gray-700
          font-medium
          transition
        " %>

  </div>

  <% if @orders.any? %>

    <% @orders
        .group_by { |order|
          order.order_items.first&.product&.restaurant
        }
        .each do |restaurant, orders| %>

      <div class="space-y-6">

        <div class="
          flex
          items-center
          justify-between
        ">

          <div>

            <h2 class="
              text-3xl
              font-bold
              text-gray-900
            ">
              <%= restaurant&.name || "Restaurante desconhecido" %>
            </h2>

            <p class="
              text-gray-500
              mt-2
            ">
              <%= pluralize(orders.count, "pedido") %>
            </p>

          </div>

        </div>

        <div class="
          grid
          grid-cols-1
          lg:grid-cols-2
          gap-6
        ">

          <% orders.each do |order| %>

            <div class="
              group
              bg-white
              rounded-2xl
              border border-gray-100
              shadow-sm
              hover:shadow-xl
              hover:-translate-y-1
              transition-all duration-300
              overflow-hidden
            ">

              <div class="
                h-2
                <%= case order.status
                    when 'pending'
                      'bg-yellow-400'
                    when 'preparing'
                      'bg-blue-500'
                    when 'delivered'
                      'bg-green-500'
                    when 'canceled'
                      'bg-red-500'
                    end %>
              "></div>

              <div class="p-6 space-y-6">

                <div class="
                  flex
                  items-start
                  justify-between
                  gap-4
                ">

                  <div>

                    <h3 class="
                      text-2xl
                      font-bold
                      text-gray-900
                    ">
                      Pedido #<%= order.id %>
                    </h3>

                    <p class="
                      text-gray-500
                      mt-2
                    ">
                      Criado em
                      <%= l(order.created_at, format: :short) %>
                    </p>

                  </div>

                  <div class="
                    px-4 py-2
                    rounded-full
                    text-sm
                    font-semibold

                    <%= case order.status
                        when 'pending'
                          'bg-yellow-100 text-yellow-700'
                        when 'preparing'
                          'bg-blue-100 text-blue-700'
                        when 'delivered'
                          'bg-green-100 text-green-700'
                        when 'canceled'
                          'bg-red-100 text-red-700'
                        end %>
                  ">

                    <%= order.status.humanize %>

                  </div>

                </div>

                <div class="
                  flex
                  items-center
                  justify-between
                ">

                  <div>

                    <p class="
                      text-sm
                      text-gray-500
                    ">
                      Total
                    </p>

                    <p class="
                      text-2xl
                      font-bold
                      text-red-500
                    ">
                      <%= number_to_currency(order.total) %>
                    </p>

                  </div>

                  <%= link_to "Ver pedido",
                      order_path(order),
                      class: "
                        text-red-500
                        hover:text-red-700
                        font-medium
                        transition
                      " %>

                </div>

              </div>

            </div>

          <% end %>

        </div>

      </div>

    <% end %>

  <% else %>

    <div class="
      bg-white
      rounded-2xl
      border border-dashed border-gray-300
      p-16
      text-center
    ">

      <h2 class="
        text-2xl
        font-semibold
        text-gray-700
      ">
        Você ainda não possui pedidos.
      </h2>

      <p class="
        text-gray-500
        mt-3
      ">
        Explore restaurantes e faça seu primeiro pedido.
      </p>

      <div class="mt-8">

        <%= link_to "Ver restaurantes",
            restaurants_path,
            class: "
              bg-red-500 hover:bg-red-600
              text-white
              font-medium
              px-6 py-3
              rounded-2xl
              shadow-md hover:shadow-lg
              transition
            " %>

      </div>

    </div>

  <% end %>

</div>
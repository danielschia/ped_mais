<h1>Pedido <%= @order.id %></h1>
<h2>Restaurante: <%= @order.restaurant.name %></h2>


<p>Status: <%= @order.status %></p>
<% if current_user.owner? && @order.pending? %>
  <%= button_to "Aceitar pedido",
                preparing_restaurant_order_path(
                  @order.restaurant,
                  @order
                ),
                method: :patch %>
<% end %>
<% unless @order.delivered? || @order.canceled? %>
  <%= button_to "Cancelar pedido",
                cancel_restaurant_order_path(@order.restaurant, @order),
                method: :patch,
                data: { turbo_confirm: "Cancelar pedido?" } %>
<% end %>
<% if current_user == @order.user %>
  <% if @order.preparing? %>
    <%= button_to "Confirmar entrega",
                  confirm_delivery_restaurant_order_path(@order.restaurant, @order),
                  method: :patch %>
  <% end %>
<% end %>
<p>Total: <%= @order.total %></p>

<%= link_to "Voltar", orders_path %>

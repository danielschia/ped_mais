<!DOCTYPE html>
<html>
  <head>
    <title>PedMais</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="relative bg-gray-800/50 after:pointer-events-none after:absolute after:inset-x-0 after:bottom-0 after:h-px after:bg-white/10">
      <div class="mx-auto max-w-7xl px-2 sm:px-6 lg:px-8">
        <div class="relative flex h-16 items-center justify-between">
          <div class="flex flex-1 items-center justify-center sm:items-stretch sm:justify-start">
            <div class="hidden sm:ml-6 sm:block">
              <div class="flex space-x-4">
                <%= link_to "Início", root_path, class: nav_link_classes(root_path) %>

                <%= link_to "Restaurantes", restaurants_path, class: nav_link_classes(restaurants_path) %>

                <% if user_signed_in? %>
                  <%= link_to "Meus Pedidos", orders_path, class: nav_link_classes(orders_path) %>
                  <span class="rounded-md px-3 py-2 text-sm font-medium text-black-300 ">Olá, <%= current_user.email %></span>
                  <%= button_to "Logout", destroy_user_session_path, method: :delete, class: logout_button_classes %>
                <% else %>
                  <%= link_to "Login", new_user_session_path, class: nav_link_classes(new_user_session_path) %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <% if notice %>
      <p><%= notice %></p>
    <% end %>

    <% if alert %>
      <p><%= alert %></p>
    <% end %>
    <main class="max-w-7xl mx-auto p-6">
      <%= yield %>
    </main>
  </body>
</html>